# Secrets and local environment
.env
.venv/
venv/

# Local data, outputs, and handoff notes
**/data/
/data/
!/data/
/data/*
!/data/splits/
/data/splits/*
!/data/splits/*.csv.gz
!/data/splits/MANIFEST.json
!/data/splits/leakage_audit.json
logs/
handoff/
results/
*.log

# Machine-specific/generated project files
parquet_locations.txt
project_structure.txt
__pycache__/
*.py[cod]
.pytest_cache/
/experiments/
!/experiments/
experiments/*
!experiments/phase2_svm_baseline.json
!experiments/phase2_grouped_cv.json
!experiments/phase3_html_sample.json

# Only keep model artifacts loaded by webapp/app.py.
# These are required for the app to run without retraining.
models/*
!models/url_tfidf.joblib
!models/url_linear_svm.joblib
!models/combined_tfidf.joblib
!models/combined_linear_svm.joblib
!models/url_engineered_scaler.joblib
!models/combined_url_scaler.joblib
!models/MANIFEST.json
!models/url_html_tfidf.joblib
!models/url_html_linear_svm.joblib
!models/html_scaler.joblib
!models/html_feature_columns.joblib
